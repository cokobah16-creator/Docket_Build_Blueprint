{
  "name": "docket",
  "private": true,
  "version": "0.3.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:test:local": "bash scripts/db-test-local.sh",
    "test:e2e": "playwright test",
    "test:layout": "node tests/fixtures/shots.mjs",
    "test:ergonomics": "node tests/fixtures/ergonomics.mjs",
    "test:composer": "node tests/fixtures/composer.mjs",
    "test:navigation": "node tests/fixtures/navigation.mjs",
    "test:design": "node tests/fixtures/design.mjs",
    "test:design:inventory": "node tests/fixtures/design.mjs --inventory",
    "auth:check": "bash scripts/check-auth-readiness.sh",
    "test:fixtures": "npm run test:layout && npm run test:ergonomics && npm run test:composer && npm run test:navigation && npm run test:design",
    "test:integration": "playwright test --config tests/integration/playwright.config.ts"
  },
  "dependencies": {
    "@daily-co/daily-js": ">=0.75.0 <1.0.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.55.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.0"

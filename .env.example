# ---- Supabase (server) ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # Edge Functions and server jobs only — never shipped to a browser
DATABASE_URL=                        # migrations / local tests

# ---- Next.js (public) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
APP_URL=https://app.docket.example

# ---- Payments ----
PAYSTACK_SECRET_KEY=                 # all card payments (decision 0002)
PAYSTACK_PUBLIC_KEY=

# ---- Video ----
DAILY_API_KEY=                       # Edge Function secret (video-session); the app never talks to Daily directly

# ---- Messaging ----
RESEND_API_KEY=
EMAIL_FROM=notifications@docket.example
TERMII_API_KEY=                      # Nigerian SMS (DND route) and OTP
TERMII_SENDER_ID=Docket
TWILIO_ACCOUNT_SID=                  # US numbers
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---- Push ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@docket.example
CRON_SECRET=                         # shared secret pg_cron sends to dispatch-notifications (Vault: cron_secret)

# ---- Observability ----
SENTRY_DSN=
POSTHOG_KEY=

# Docket environment. Two audiences:
#   [app]  → .env.local for the Next.js app (slice 1+); NEXT_PUBLIC_* is the
#            only section that ever reaches the browser.
#   [edge] → `supabase secrets set` for the Edge Functions.
# The service-role key is used ONLY by Edge Functions — never in the app.

# --- Supabase [app + edge] ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Injected automatically into Edge Functions by Supabase; listed for local dev.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Direct Postgres connection — local testing and psql seed only.
DATABASE_URL=postgres://postgres@localhost:5432/postgres

# --- App ---------------------------------------------------------------------
# Absolute base URL used in notification links and payment callbacks.
APP_BASE_URL=https://klinique.docket.app

# --- Payments: Paystack (NGN, settles to the Nigerian entity) [app + edge] ---
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_PUBLIC_KEY=pk_test_...

# --- Payments: Stripe (USD, settles to the US entity) [app + edge] -----------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# From the Stripe dashboard after registering /functions/v1/stripe-webhook.
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Video: Daily [app] ------------------------------------------------------
DAILY_API_KEY=...

# --- Email: Resend [app + edge] ----------------------------------------------
RESEND_API_KEY=re_...
EMAIL_FROM="Attorneys Klinique <notifications@mail.docket.app>"

# --- SMS: Termii (primary, DND channel for Nigerian numbers) [app + edge] ----
TERMII_API_KEY=...
TERMII_SENDER_ID=Docket

# --- SMS: Twilio (fallback / Supabase Auth OTP while Termii hook is pending) -
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM=+1...

# --- Web push (generate once: `npx web-push generate-vapid-keys`) [edge] -----
VAPID_PUBLIC_KEY=...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:support@docket.app
# Also exposed to the app for PushManager.subscribe():
NEXT_PUBLIC_VAPID_PUBLIC_KEY=...

# --- Cron → dispatch-notifications [edge] ------------------------------------
# Bearer token the Supabase Cron HTTP schedule sends; any long random string.
CRON_SECRET=...
